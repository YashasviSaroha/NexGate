# ========================
# NexGate Environment Variables
# ========================

# Database (PostgreSQL)
DATABASE_URL=postgresql://nexgate:nexgate_dev_password@localhost:5432/nexgate

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
JWT_EXPIRY=24h
SESSION_SECRET=change-me-to-another-secure-random-string-32-chars

# Encryption (32-byte hex key for API key encryption)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Server
PORT=3000
NODE_ENV=development

# Rate Limiting (Auth endpoints)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Gateway
GATEWAY_REQUEST_TIMEOUT_MS=30000
GATEWAY_MAX_REQUEST_SIZE=10mb

# Allow http://localhost and 127.0.0.1 upstreams. Required for the built-in mock.
# Set to false in any shared or production deployment.
ALLOW_LOCAL_UPSTREAM=true

# Google Gemini. Server only. Leave blank to disable the assistant.
# Never put this value in frontend env files or client code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_OUTPUT_TOKENS=800

# Public demo identity. This mailbox cannot sign in with a password.
DEMO_USER_EMAIL=visitor@demo.nexgate.local
DEMO_DAILY_AI_LIMIT=8
USER_DAILY_AI_LIMIT=40
